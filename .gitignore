.DS_Store
node_modules/

# Ignore contents of temporary/session directories
sessions/*
tmp/*
public/xiaozhi/*

# Keep the directories tracked via .gitkeep
!sessions/.gitkeep
!tmp/.gitkeep
!public/xiaozhi/.gitkeep

# Environments
.env
.env.*
!.env.example
!.env.example.local

# Logs
*.log
*-audit.json

# Dynamic Data
devices.json
mcp_devices.json
remote-mcp-servers.json
remote-mcp-servers.json.*.tmp
agent-connections.json
agent-connections.json.*.tmp

# Private persistent feature data
data/
memory/

# SQLite memory and temporary journal files
*.sqlite
*.sqlite-*
!.env.mqtt.example
certs/*
!certs/README.md
