# Private-LAN example ONLY. Read docs/SETUP_ID.md before using it.
# Replace every 192.168.1.50 with this server's LAN IP. Do not expose this
# plaintext MQTT/HTTP setup to the internet or an untrusted network.
GEMINI_API_KEY=your_gemini_api_key_here
LLM_BACKEND=gemini
ADMIN_PASSWORD=your_unique_admin_password_here
CLIENT_AUTH_TOKEN=your_legacy_client_auth_token_here
HOST=0.0.0.0
PORT=3000
WEB_BIND_ADDRESS=192.168.1.50
WEB_PORT=3000
WEBSOCKET_URL_FOR_ALLOWED_DEVICE=ws://192.168.1.50:3000/xiaozhi/v1/
COOKIE_SECURE=false

# Supply TWO DIFFERENT high-entropy secrets of >=32 characters securely.
# Placeholders are rejected. Do not paste real values into chat or Git.
MQTT_ENABLED=true
MQTT_SIGNATURE_KEY=REPLACE_ME_WITH_OPERATOR_SUPPLIED_SIGNATURE_SECRET
MQTT_GATEWAY_KEY=REPLACE_ME_WITH_DIFFERENT_OPERATOR_SUPPLIED_GATEWAY_SECRET
MQTT_BIND_ADDRESS=192.168.1.50
MQTT_ENDPOINT=192.168.1.50:1883
MQTT_PUBLIC_HOST=192.168.1.50
MQTT_PORT=1883
MQTT_UDP_PORT=8884
# Explicit opt-in to plaintext MQTT for this trusted-LAN test only.
MQTT_ALLOW_INSECURE=true
MQTT_GATEWAY_URL=http://127.0.0.1:3001
MQTT_REGISTRY_URL=http://127.0.0.1:3000/internal/mqtt/devices/
MQTT_UPSTREAM_URL=ws://127.0.0.1:3000/xiaozhi/v1/
MQTT_BIND_HOST=0.0.0.0
MQTT_UDP_BIND_HOST=0.0.0.0
MQTT_HTTP_BIND_HOST=127.0.0.1
MQTT_HTTP_PORT=3001
MQTT_TLS_CERT_FILE=
MQTT_TLS_KEY_FILE=
# For MQTT TLS instead: port/endpoint 8883, MQTT_ALLOW_INSECURE=false, and
# user-provided MQTT_TLS_CERT_FILE=/run/mqtt-tls/fullchain.pem
# plus MQTT_TLS_KEY_FILE=/run/mqtt-tls/privkey.pem (inside Docker).

# Built-in authenticated HTTP gateway adapter; no custom adapter or Redis needed.
NOTIFY_ENABLED=true
NOTIFY_ALLOW_HTTP=true
NOTIFY_ALLOWED_AUDIO_ORIGINS=http://192.168.1.50:3000
MQTT_AUDIO_ALLOWED_ORIGINS=http://192.168.1.50:3000
NOTIFY_AUDIO_BASE_URL=http://192.168.1.50:3000
NOTIFY_TIMEOUT_MS=5000
MEMORY_CONTEXT_MAX_CHARS=6000
MEMORY_MAX_TURNS=8
MEMORY_TURN_MAX_CHARS=1200

# External Hermes/MCP sender: set exact approved device MAC(s) after first setup.
# Keep disabled [] until you supply a THIRD distinct secret securely and your MAC.
NOTIFY_SENDERS_JSON=[]
# NOTIFY_SENDERS_JSON=[{"name":"hermes","token_env":"HERMES_NOTIFY_TOKEN","device_ids":["aa:bb:cc:dd:ee:ff"]}]
# HERMES_NOTIFY_TOKEN=REPLACE_ME_WITH_THIRD_OPERATOR_SUPPLIED_SENDER_SECRET
NOTIFY_BEEP_ASSET=sample-chime.ogg
INBOX_TOOL_MAX_CHARS=4000

# Stock firmware expects minutes, not seconds; UTC timestamp remains milliseconds.
# Explicit package default: WIB / UTC+7. Set 0 for UTC, 480 for UTC+8, etc.
DEVICE_TIMEZONE_OFFSET_MINUTES=420
