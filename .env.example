# --- API Keys ---

# Google Gemini API Key - Get one from https://aistudio.google.com/
# Required if using 'gemini' backend
GEMINI_API_KEY=your_gemini_api_key_here

# Alibaba DashScope API Key - Get one from DashScope Model Studio
# Required if using 'qwen', 'qwen_realtime', or 'qwen_omni' backends
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Llama / Local Model Server URL
# Required if using 'llama_liquid_audio_server' or 'llama_liquid_interleaved'
LIQUID_SERVER_URL=http://127.0.0.1:8080/v1/chat/completions


# --- Default Session Configuration ---

# Initial LLM Backend to use ('gemini', 'qwen_realtime', 'llama_liquid_interleaved', etc.)
# Note: Backends can be overridden per-device in the Web UI.
LLM_BACKEND=gemini

# Return voice sessions to standby after this many seconds without detected speech.
# Device Config can override it. 0 disables; otherwise use 15–3600 seconds.
# AI output/playback and pending tools pause it; silent audio packets do not reset it.
VOICE_IDLE_TIMEOUT_SECONDS=60
# Minimum microphone energy threshold (50–10000, default 500).
# The standby detector raises it automatically above the estimated background noise.
# Lower for quiet voices; higher if varying background noise prevents standby.
# VOICE_ACTIVITY_THRESHOLD=500

# Optional: Default Model & Voice Overrides
# GEMINI_MODEL=gemini-3.8-live
# GEMINI_VOICE=Aoede
# QWEN_MODEL=qwen3-omni-flash-realtime
# QWEN_VOICE=Cherry
# LLAMA_MODEL=llama-liquid-interleaved
# LLAMA_VOICE=UK female


# --- Server & Auth Configuration ---

# INFO includes session lifecycle tracing and a status summary every 15 seconds.
# Use debug for control-message details and transcription character counts (no text).
LOG_LEVEL=info

CLIENT_AUTH_TOKEN=your_client_auth_token_here
ADMIN_PASSWORD=your_admin_password_here

HOST=127.0.0.1
PORT=3000

# For servers behind Nginx, use your public domain and wss://
# MQTT_ENDPOINT=your-example-domain.com:8883
# WEBSOCKET_URL_FOR_ALLOWED_DEVICE=wss://your-example-domain.com/xiaozhi/v1/

# For local testing, see .env.example.local
MQTT_ENDPOINT=127.0.0.1
WEBSOCKET_URL_FOR_ALLOWED_DEVICE=ws://127.0.0.1:3000/xiaozhi/v1/

# --- Memory and notifications ---
# Optional directory for devices, dashboard sessions, logs and private memory.
# DATA_DIR=./data
# Each approved device opts into memory in the dashboard (off by default).
# New feature endpoints require a unique ADMIN_PASSWORD of >=12 characters.
# Behind HTTPS, enable secure cookies; configure Express proxy trust separately
# if TLS terminates at a proxy rather than in this process.
COOKIE_SECURE=false

# Notifications are off by default. The bundled MQTT gateway needs no custom adapter.
NOTIFY_ENABLED=false
# Optional override: operator-owned local JS file exporting {rpc: async envelope => result}.
# NOTIFY_ADAPTER_MODULE=/absolute/path/to/gateway-adapter.js
# Custom-adapter override only: explicit approved device ID -> gateway clientId map.
# NOTIFY_CLIENT_IDS_JSON={"aa:bb:cc:dd:ee:ff":"existing-gateway-client-id"}
# Exact HTTPS audio origins; this server never downloads/proxies audio URLs.
# NOTIFY_ALLOWED_AUDIO_ORIGINS=https://audio.example.com
NOTIFY_ALLOW_HTTP=false
NOTIFY_TIMEOUT_MS=5000

# Hard character budget for the ENTIRE injected memory section incl. wrapper.
# Not an exact token count and not a limit on ongoing Gemini Live session context.
MEMORY_CONTEXT_MAX_CHARS=6000
# Maximum retained completed turns per device (1..24).
MEMORY_MAX_TURNS=8
# Maximum characters per side of each retained turn (100..2000).
MEMORY_TURN_MAX_CHARS=1200

# --- Optional bundled MQTT gateway ---
# Default remains WebSocket. For a complete LAN template see .env.mqtt.example.
MQTT_ENABLED=false
MQTT_ALLOW_INSECURE=false
# MQTT_SIGNATURE_KEY=<operator-provided high-entropy secret, >=32 characters>
# MQTT_GATEWAY_KEY=<different operator-provided high-entropy secret, >=32 chars>
# MQTT_ENDPOINT=your-mqtt-host.example:8883
# MQTT_PUBLIC_HOST=your-mqtt-host.example
MQTT_PORT=8883
MQTT_UDP_PORT=8884
MQTT_GATEWAY_URL=http://127.0.0.1:3001
# MQTT_TLS_CERT_FILE=/run/mqtt-tls/fullchain.pem
# MQTT_TLS_KEY_FILE=/run/mqtt-tls/privkey.pem
# NOTIFY_AUDIO_BASE_URL=https://your-audio-host.example
# MQTT_AUDIO_ALLOWED_ORIGINS=https://your-audio-host.example
# Use bundled notification-audio/sample-chime.ogg or your own mono Ogg Opus file.
# Only for an existing trusted HTTPS reverse proxy. List its exact peer IP/CIDR;
# never true or a hop count. Leave unset for direct HTTP / trusted LAN tests.
# TRUST_PROXY=loopback

# --- External notification inbox (separate from conversation memory) ---
# Simplest setup: MCP Devices -> Hubungkan agent creates a scoped token in the dashboard.
# The list below is only for manually configured senders; never reuse MQTT secrets.
NOTIFY_SENDERS_JSON=[]
# Example: [{"name":"hermes","token_env":"HERMES_NOTIFY_TOKEN","device_ids":["aa:bb:cc:dd:ee:ff"]}]
# HERMES_NOTIFY_TOKEN=<another operator-provided high-entropy secret, >=32 chars>
NOTIFY_BEEP_ASSET=sample-chime.ogg
# One reminder per idle MQTT device while unread messages remain. 0 disables it.
NOTIFY_REMINDER_INTERVAL_MS=60000
# Outgoing remote MCP connections use HTTPS or loopback HTTP by default.
# Explicit opt-in for an agent hosted on a trusted LAN/container network.
MCP_ALLOW_HTTP=false
INBOX_TOOL_MAX_CHARS=4000
# Headless clients omit Origin. Browser origins are denied unless explicitly listed.
# NOTIFY_INGRESS_ORIGINS=https://your-trusted-client.example

# Stock firmware expects minutes, not seconds; UTC timestamp remains milliseconds.
# Explicit package default: WIB / UTC+7. Set 0 for UTC, 480 for UTC+8, etc.
DEVICE_TIMEZONE_OFFSET_MINUTES=420
